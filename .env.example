# Copy to .env and fill in. .env is gitignored; this file is not, so it must stay empty
# of real values. The repository is public.

# --- AWS (needed to run the agents against a real model) -----------------------
# Prefer a named profile over keys: aws configure sso && aws sso login
AWS_PROFILE=glass-guru
AWS_REGION=us-east-1

# --- Model -------------------------------------------------------------------
GLASS_GURU_LLM=bedrock
GLASS_GURU_MODEL_ID=us.amazon.nova-lite-v1:0

# --- Travel ------------------------------------------------------------------
# frozen: committed snapshot, offline and free, known addresses only
# warm:   snapshot plus live OSRM for new addresses (needs docker compose up -d osrm)
GLASS_GURU_TRAVEL=frozen

# --- Tracing (optional) ------------------------------------------------------
# Without these, tracing is a no-op and everything still works.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=glass-guru
# GLASS_GURU_TRACE_CONSOLE=1
